NODE_ENV=development
PORT=5000

# Option A — Local MongoDB
# DATABASE_URL=mongodb://localhost:27017/leadflow

# Option B — MongoDB Atlas (standard SRV, works if your network allows it)
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/leadflow

# Option C — MongoDB Atlas direct connection (use if SRV DNS is blocked on your network)
# Resolve SRV records first: nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net 8.8.8.8
# Then resolve TXT for replicaSet name: nslookup -type=TXT _mongodb._tcp.<cluster>.mongodb.net 8.8.8.8
DATABASE_URL=mongodb://<username>:<password>@<shard-00>.mongodb.net:27017,<shard-01>.mongodb.net:27017,<shard-02>.mongodb.net:27017/leadflow?ssl=true&replicaSet=<replicaSetName>&authSource=admin&retryWrites=true&w=majority

# JWT — generate strong random secrets for production
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Client URL for CORS — comma-separated list of allowed origins
# CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
